# ── Claude Code (or any Anthropic-API client) -> LiteLLM + Presidio -> LOCAL Ollama model ──
# NO Anthropic API key anywhere. This architecture has no cloud upstream.
# Copy to .env and adjust. `.env` is gitignored.

# Proxy auth (any string). The client sends this as ANTHROPIC_AUTH_TOKEN.
LITELLM_MASTER_KEY=sk-local-dev

# Local model. Use a coding-tuned, tool-calling model. Examples: qwen2.5-coder:7b (or :32b),
# llama3.1, glm-4-*. Must support tool/function calling for the T1 viability test.
OLLAMA_MODEL=qwen2.5-coder:7b
# Ollama runs on the host; containers reach it via host.docker.internal
OLLAMA_API_BASE=http://host.docker.internal:11434
# Host-side view of Ollama (scripts hit this directly). Change if Ollama runs elsewhere.
OLLAMA_API_BASE_HOST=http://localhost:11434

# Presidio (container-network hostnames + internal port 3000; used by LiteLLM inside compose)
PRESIDIO_ANALYZER_API_BASE=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_API_BASE=http://presidio-anonymizer:3000
# Host-side Presidio ports (tests hit these from the host)
PRESIDIO_ANALYZER_HOST=http://localhost:5002

# The repo to audit. T2 (FP) / T6 (secrets) scan CORPUS_DIR; T1 (interactive) works in TARGET_REPO.
# Default "." = the current working directory (run the audit from inside the repo you want to test).
CORPUS_DIR=.
TARGET_REPO=.

# Which guardrail profile to bring up: 1 = strict/aggressive, 2 = pragmatic default
LITELLM_PROFILE=2
# Optional explicit config path override (used by the capture profile). Leave blank normally.
LITELLM_CONFIG=

# ── Image pins (overridable so a bad tag can be swapped without editing docker-compose) ──
# LiteLLM v1.98.0: chosen to be AFTER the 1.82.7/1.82.8 PyPI malware window AND after the Presidio
# streaming-unmask fix (PR #30028 for issue #22821). VERIFY registry: docker.litellm.ai OR ghcr.io/berriai.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.98.0
# Presidio moved off the stale mcr.microsoft.com images to data-privacy-stack. VERIFY newest 2.2.x tag.
PRESIDIO_ANALYZER_IMAGE=ghcr.io/data-privacy-stack/presidio-analyzer:2.2.362
PRESIDIO_ANONYMIZER_IMAGE=ghcr.io/data-privacy-stack/presidio-anonymizer:2.2.362

# Host-side ports: analyzer -> localhost:5002, anonymizer -> localhost:5001, litellm -> localhost:4000
